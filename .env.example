# DSH plugin
BILIMEMORY_ADMIN_URL=http://127.0.0.1:8765
BILIMEMORY_MEMORY_SCOPE=global

# BiliMemory backend paths
BILIMEMORY_ROOT=C:\path\to\BiliMemory
MAIBOT_ROOT=C:\Users\you\AppData\Roaming\MaiBotOneKeyDesktop\<instance>\modules\MaiBot
MAIBOT_PYTHON=C:\Users\you\AppData\Roaming\MaiBotOneKeyDesktop\<instance>\modules\MaiBot\.onekey\environments\<env>\python.exe

# Python interpreter used for optional Whisper transcription and frame analysis
BILIMEMORY_MEDIA_PYTHON=C:\path\to\BiliMemory\.venv\Scripts\python.exe
